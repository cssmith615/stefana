{
  "expo": {
    "name": "Stefana",
    "slug": "stefana",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "stefana",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFAF8"
    },
    "ios": {
      "bundleIdentifier": "com.stefana.weddingplanner",
      "buildNumber": "5",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Stefana uses your camera to scan receipts and vendor contracts.",
        "NSPhotoLibraryUsageDescription": "Stefana accesses your photo library to attach photos to vendors and expenses.",
        "NSUserNotificationsUsageDescription": "Stefana sends reminders for upcoming wedding tasks and countdowns.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stefana.weddingplanner",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FDFAF8"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A96E",
          "sounds": []
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stefana uses your photo library to add inspiration images to your moodboard.",
          "cameraPermission": "Stefana uses your camera to capture inspiration photos."
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f829736a-4d49-475d-b368-51ff323e9ea0"
      },
      "privacyPolicyUrl": "https://cssmith615.github.io/stefana",
      "supportUrl": "https://cssmith615.github.io/stefana/support.html"
    },
    "owner": "chuckssmith"
  }
}
